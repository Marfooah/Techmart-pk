generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider     = "sqlite"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

enum Role {
  CUSTOMER
  AGENT
  ADMIN
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  IN_TRANSIT
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentMethod {
  COD
  CARD
  BANK_TRANSFER
  WALLET
  OTHER
}

enum ProductStatus {
  ACTIVE
  OUT_OF_STOCK
  DISCONTINUED
}

enum ReturnStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  REFUNDED
}

enum ReturnReason {
  DAMAGED
  DEFECTIVE
  WRONG_ITEM
  NOT_AS_DESCRIBED
  CHANGED_MIND
  OTHER
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  ESCALATED
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketCategory {
  ORDER
  SHIPPING
  RETURN
  REFUND
  WARRANTY
  PRODUCT
  ACCOUNT
  OTHER
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
  AGENT
}

enum Sentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
  FRUSTRATED
  ANGRY
}

enum ResolutionType {
  AI
  HUMAN
  HYBRID
}

enum TrackingEventType {
  ORDER_PLACED
  PROCESSING
  SHIPPED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  DELAYED
  OTHER
}

enum AnalyticsEventType {
  PAGE_VIEW
  CHAT_STARTED
  TICKET_CREATED
  RETURN_REQUESTED
  ESCALATION
  AI_TOOL_CALLED
  APPROVAL_ACTION
  LOGIN
  OTHER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(CUSTOMER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer         Customer?
  assignedTickets  Ticket[]         @relation("AssignedAgent")
  analyticsEvents  AnalyticsEvent[]
}

model Customer {
  id              String   @id @default(cuid())
  userId          String   @unique
  phone           String?
  shippingAddress String?
  city            String?
  province        String?
  postalCode      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders         Order[]
  returnRequests ReturnRequest[]
  tickets        Ticket[]
  conversations  Conversation[]
  aiAuditLogs    AiAuditLog[]
}

model Product {
  id             String        @id @default(cuid())
  externalId     String?       @unique
  sku            String        @unique
  name           String
  brand          String?
  category       String
  price          Float
  currency       String        @default("PKR")
  stock          Int           @default(0)
  status         ProductStatus @default(ACTIVE)
  unitsAvailable Int?
  warrantyMonths Int?
  rating         Float?
  bestFor        String?
  description    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  orderItems OrderItem[]
}

model Order {
  id              String        @id @default(cuid())
  externalId      String?       @unique
  orderDate       DateTime
  customerId      String
  status          OrderStatus   @default(PENDING)
  paymentMethod   PaymentMethod @default(COD)
  courierPartner  String?
  trackingNumber  String?
  shippingAddress String?
  city            String?
  province        String?
  postalCode      String?
  subtotal        Float
  total           Float
  currency        String        @default("PKR")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  customer       Customer        @relation(fields: [customerId], references: [id])
  items          OrderItem[]
  returnRequests ReturnRequest[]
  tickets        Ticket[]
  trackingEvents TrackingEvent[]
}

model OrderItem {
  id         String @id @default(cuid())
  orderId    String
  productId  String
  quantity   Int
  unitPrice  Float
  totalPrice Float

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model ReturnRequest {
  id              String       @id @default(cuid())
  orderId         String
  customerId      String
  reason          ReturnReason
  description     String?
  status          ReturnStatus @default(PENDING)
  requestedAt     DateTime     @default(now())
  reviewedAt      DateTime?
  reviewedById    String?
  rejectionReason String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  order    Order    @relation(fields: [orderId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@index([orderId])
  @@index([status])
}

model Ticket {
  id               String          @id @default(cuid())
  ticketNumber     String          @unique
  customerId       String
  orderId          String?
  assignedAgentId  String?
  subject          String
  description      String
  category         TicketCategory
  status           TicketStatus    @default(OPEN)
  priority         TicketPriority  @default(MEDIUM)
  sentiment        Sentiment       @default(NEUTRAL)
  resolutionType   ResolutionType?
  escalationReason String?
  confidenceScore  Float?
  isEscalated      Boolean         @default(false)
  resolvedAt       DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  customer      Customer       @relation(fields: [customerId], references: [id])
  order         Order?         @relation(fields: [orderId], references: [id])
  assignedAgent User?          @relation("AssignedAgent", fields: [assignedAgentId], references: [id])
  conversations Conversation[]

  @@index([customerId])
  @@index([assignedAgentId])
  @@index([status])
  @@index([priority])
}

model Conversation {
  id         String    @id @default(cuid())
  customerId String
  ticketId   String?
  title      String?
  isActive   Boolean   @default(true)
  startedAt  DateTime  @default(now())
  endedAt    DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  customer Customer  @relation(fields: [customerId], references: [id])
  ticket   Ticket?   @relation(fields: [ticketId], references: [id])
  messages Message[]

  @@index([customerId])
  @@index([ticketId])
}

model Message {
  id              String      @id @default(cuid())
  conversationId  String
  role            MessageRole
  content         String
  sentiment       Sentiment?
  confidenceScore Float?
  metadata        String?
  createdAt       DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([createdAt])
}

model TrackingEvent {
  id          String            @id @default(cuid())
  orderId     String
  eventType   TrackingEventType
  status      String
  location    String?
  description String?
  occurredAt  DateTime
  createdAt   DateTime          @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([occurredAt])
}

model AnalyticsEvent {
  id        String             @id @default(cuid())
  eventType AnalyticsEventType
  userId    String?
  metadata  String?
  createdAt DateTime           @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([eventType])
  @@index([createdAt])
}

model AiAuditLog {
  id              String   @id @default(cuid())
  timestamp       DateTime @default(now())
  customerId      String?
  conversationId  String?
  ticketId        String?
  toolCalled      String
  input           String
  output          String?
  confidenceScore Float?
  success         Boolean
  escalated       Boolean  @default(false)
  errorMessage    String?

  customer Customer? @relation(fields: [customerId], references: [id])

  @@index([timestamp])
  @@index([customerId])
  @@index([toolCalled])
  @@index([success])
  @@index([escalated])
}

model KnowledgeDocument {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  sourcePath  String
  contentHash String
  updatedAt   DateTime @updatedAt

  chunks KnowledgeChunk[]
}

model KnowledgeChunk {
  id         String @id @default(cuid())
  documentId String
  chunkIndex Int
  content    String
  metadata   String?
  embedding  String

  document KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}
